venv/
# --- AI Shared Memory (local only) ---
Docs/
# --- Claude Code local tooling ---
.claude/
# --- Environment Files ---
# NEVER commit your secrets.
.env
!.env.example
# --- Go Specific ---
# The binary generated by 'go build'
identity-svc
# Binaries produced by `go build ./cmd/server` when run from a service's
# root directory (e.g. music-playback-service/server) — this pattern is
# scoped to exactly one directory level so it does NOT match the cmd/server/
# SOURCE directories that exist in every service (those are two levels
# deep: <service>/cmd/server).
*/server
# Dependencies directory (not needed, go.mod handles this)
vendor/
# Test coverage files
*.out
*.test

# --- Docker & Colima ---
# Ignore local docker state
.docker/
# If you ever mount local databases or volumes
data/

# macOS
.DS_Store
# VS Code
.vscode/

# --- Temporary Files ---
# Logs and temp files
*.log
tmp/
*.tmp

# my notepad 
*.txt