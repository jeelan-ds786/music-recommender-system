PORT=8082
DB_URL=postgres://muse:secret@localhost:5434/muse_playback?sslmode=disable
# Must be the exact same value as music-identity-gatekeeper's JWT_SECRET —
# this service only verifies access tokens issued by that one, it never
# issues its own.
JWT_SECRET=replace-with-a-long-random-secret

# One of: debug, info, error, none/off (case-insensitive). Defaults to
# info if unset or unrecognized. debug shows the full per-request lifecycle:
# auth Starting/Ending, service Starting/Ending, automatic postgres
# READ/WRITE query logs, and the final "request completed" line.
LOG_LEVEL=info