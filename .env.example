# Root-level env, used ONLY by `docker compose up identity-svc` for
# ${VAR} substitution into that container's environment (see
# docker-compose.yml). Copy to `.env` in this directory if you run the
# full stack via Docker Compose instead of `make dev`.
#
# Running `identity-svc` locally with `make dev` instead? Use
# music-identity-gatekeeper/.env.example — it documents every variable
# the service reads, including these same three plus DB_URL, PORT,
# LOG_LEVEL, KAFKA_BROKERS, and the relay settings.

JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
