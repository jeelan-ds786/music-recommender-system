            "likes",
            "songs",
            "{{likedSongId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('likedSongId')) {",
              "    pm.collectionVariables.set('likedSongId', pm.variables.replaceIn('{{$guid}}'));",
              "}"
