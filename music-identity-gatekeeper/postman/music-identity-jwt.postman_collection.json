    {
      "name": "4. Me (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected endpoint status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var body = {};",
              "try { body = pm.response.json(); } catch (e) {}",
              "var data = body.data || {};",
              "",
              "pm.test('Response has account, profile, tier, preferences', function () {",
              "    pm.expect(data.account).to.be.an('object');",
              "    pm.expect(data.account.email).to.eql(pm.collectionVariables.get('email'));",
              "    pm.expect(data.profile).to.be.an('object');",
              "    pm.expect(data.tier).to.eql('free');",
              "    pm.expect(data.preferences).to.be.an('object');",
              "    pm.expect(data.preferences.liked_song_ids).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
