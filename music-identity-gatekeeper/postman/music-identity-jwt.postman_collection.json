  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/register",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register status is 201 or 409', function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/login",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Tokens returned from login', function () {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refresh_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
              "if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);"
            ]
          }
        }
      ]
    },
