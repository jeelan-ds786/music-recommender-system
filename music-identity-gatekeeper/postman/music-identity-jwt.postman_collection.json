{
  "info": {
    "_postman_id": "a1d0db65-46d7-4f57-a6d6-2d2ab7b2e321",
    "name": "Music Identity JWT Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/register",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register status is 201 or 409', function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/login",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Tokens returned from login', function () {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refresh_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
              "if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Me Unauthenticated (Should Fail)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated /me is rejected with structured 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Error body has an error code', function () {",
              "    pm.expect(data.error).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Me (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected endpoint status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var body = {};",
              "try { body = pm.response.json(); } catch (e) {}",
              "var data = body.data || {};",
              "",
              "pm.test('Response has account, profile, tier, preferences', function () {",
              "    pm.expect(data.account).to.be.an('object');",
              "    pm.expect(data.account.email).to.eql(pm.collectionVariables.get('email'));",
              "    pm.expect(data.profile).to.be.an('object');",
              "    pm.expect(data.tier).to.eql('free');",
              "    pm.expect(data.preferences).to.be.an('object');",
              "    pm.expect(data.preferences.liked_song_ids).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Patch Me - Display Name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"display_name\": \"User1\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Patch status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var body = {};",
              "try { body = pm.response.json(); } catch (e) {}",
              "var data = body.data || {};",
              "",
              "pm.test('display_name was set, other fields untouched', function () {",
              "    pm.expect(data.profile.display_name).to.eql('User1');",
              "    pm.expect(data.profile.country).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Patch Me - Country (Verifies Prior Field Preserved)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country\": \"US\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Patch status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var body = {};",
              "try { body = pm.response.json(); } catch (e) {}",
              "var data = body.data || {};",
              "",
              "pm.test('country was set AND display_name from the previous patch survived', function () {",
              "    pm.expect(data.profile.country).to.eql('US');",
              "    pm.expect(data.profile.display_name).to.eql('User1');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Patch Me - Invalid Country (Should Fail)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country\": \"us\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lowercase country code is rejected with structured 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Error identifies the country field', function () {",
              "    pm.expect(data.field).to.eql('country');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Patch Me - Invalid Birth Year (Should Fail)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"birth_year\": 1800\n}"
        },
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Out-of-range birth year is rejected with structured 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Error identifies the birth_year field', function () {",
              "    pm.expect(data.field).to.eql('birth_year');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/refresh",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refresh status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('New tokens returned from refresh', function () {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refresh_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (data.refresh_token) {",
              "    pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));",
              "    pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}",
              "if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Refresh With Old Token (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{oldRefreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{migUrl}}/auth/refresh",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Old refresh token is rejected', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Me With Invalid JWT (Should Fail)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer not.a.real.jwt"
          }
        ],
        "url": {
          "raw": "{{migUrl}}/me",
          "host": [
            "{{migUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid JWT is rejected', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "migUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "jwt_test@example.com"
    },
    {
      "key": "password",
      "value": "Password123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    }
  ]
}
