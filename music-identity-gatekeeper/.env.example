# Copy this file to .env and fill in real values. .env is gitignored;
# this file should only ever contain placeholders.

# --- Required ---

# PostgreSQL connection string.
DB_URL=postgres://muse:secret@localhost:5432/muse_identity?sslmode=disable

# HMAC signing secret for access/refresh JWTs. The server calls log.Fatal
# at startup if this is unset.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth2 credentials. The server calls log.Fatal at startup if any
# of these three are unset — even if you don't intend to test OAuth.
# Placeholder values are fine for local work that doesn't touch
# /auth/google.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- Optional (all have working defaults) ---

# HTTP port. Defaults to 8080 if unset.
PORT=8080

# Redis address, used for OAuth CSRF state storage. Defaults to
# localhost:6379 if unset.
REDIS_ADDR=localhost:6379

# One of: debug, info, error, none/off (case-insensitive). Defaults to
# info if unset or unrecognized.
LOG_LEVEL=info

# Comma-separated Kafka broker addresses, e.g. localhost:9094 for this
# repo's docker-compose.yml. If unset, events are still durably enqueued
# but published via a no-op publisher (discarded) instead of a real broker.
KAFKA_BROKERS=localhost:9094

# On/off switch for the background outbox relay (the fallback sweep that
# retries events which failed their initial direct-publish attempt).
# Strict boolean (true/false, 1/0, t/f). Defaults to true if unset.
KAFKA_RELAY_ENABLED=true

# How often the relay fallback sweep wakes up to retry pending events. Go
# duration string (e.g. 30s, 1m, 5m). Defaults to 1m if unset.
KAFKA_RELAY_INTERVAL=1m
